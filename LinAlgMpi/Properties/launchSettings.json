{
  "profiles": {
    "NoMpi": {
      "commandName": "Project",
      "workingDirectory": "$(TargetDir)"
    },
    "MpiSingleMachine": {
      "commandName": "Executable",
      "executablePath": "mpiexec",
      "commandLineArgs": "-n 4 $(TargetDir)$(TargetName).exe"
    },
    "MpiMultiMachines": {
      "commandName": "Executable",
      "executablePath": "mpiexec",
      "commandLineArgs": "-n 4 -machinefile \"$(SolutionDir)hosts\\lan_hosts.txt\" \"$(TargetDir)$(TargetName).exe\""
    }
  }
}